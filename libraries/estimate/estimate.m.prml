---
kind: module
---
|% estimate — a general estimate: items by sections, section subtotals, discount, VAT and the total.
|% Commands: |estimate.table(items, …) draws the table, |estimate.total_words(items, …) writes the total
|% in figures and in words. Functions: problem, line_total, sections, section_total, totals.
|% The rules and the limits are in README.md. A document imports the module with |import("lib/estimate").
|code:
VERSION = "0.1.0"

# Texts of the table. A document replaces any of them with labels={"name": "Description", …}.
LABELS = {
    "number": "№",
    "name": "Найменування",
    "unit": "Од.",
    "qty": "Кількість",
    "price": "Ціна",
    "sum": "Сума",
    "net": "Разом",
    "discount": "Знижка",
    "taxable": "Разом зі знижкою",
    "vat": "ПДВ",
    "total": "Усього до сплати",
}


def _number_problem(value, label):
    """Reason when value is not a non-negative number, or ""."""
    if type(value) != "decimal":
        return "очікується число: " + label
    if value < 0:
        return "від'ємне значення: " + label
    return ""


def _rate_problem(rate, label):
    """Reason when a percent is given and is not in 0..100, or ""; None means "not applied"."""
    if rate is None:
        return ""
    if type(rate) != "decimal":
        return "очікується відсоток: " + label
    if rate < 0 or rate > 100:
        return "відсоток поза межами 0–100: " + label
    return ""


def problem(items, vat=None, discount=None):
    """Why the estimate cannot be calculated, or "".

    Args:
        items: list of records {name, qty, price} with optional section, unit.
        vat: VAT percent (20 means 20 %), None — no VAT.
        discount: discount percent on the net total, None — no discount.

    Returns:
        The first reason in Ukrainian, "" when everything is in order.
    """
    if type(items) != "list" or len(items) == 0:
        return "очікується непорожній список позицій"
    for number, item in enumerate(items, 1):
        where = f"позиція {number}"
        if type(item) != "dict":
            return where + ": очікується запис"
        name = item.get("name")
        if type(name) != "str" or name == "":
            return where + ": немає найменування"
        reason = _number_problem(item.get("qty"), "кількість")
        if reason == "":
            reason = _number_problem(item.get("price"), "ціна")
        if reason != "":
            return where + ": " + reason
        for key in ("section", "unit"):
            if item.get(key) is not None and type(item.get(key)) != "str":
                return where + ": очікується рядок: " + key
    reason = _rate_problem(vat, "ПДВ")
    if reason == "":
        reason = _rate_problem(discount, "знижка")
    return reason


def line_total(item):
    """Amount of one item: quantity times price, rounded to kopecks (half away from zero)."""
    return round_money(item["qty"] * item["price"])


def sections(items):
    """Section names in the order of first appearance; "" stands for items without a section."""
    found = []
    for item in items:
        name = item.get("section") or ""
        if name not in found:
            found.append(name)
    return found


def section_total(items, section):
    """Sum of the amounts of one section ("" — items without a section)."""
    return sum([line_total(item) for item in items if (item.get("section") or "") == section], dec("0"))


def totals(items, vat=None, discount=None):
    """The totals of an estimate.

    The discount is taken from the net total, VAT is added on the discounted amount.
    Every step is rounded to kopecks (half away from zero).

    Args:
        items: list of records {name, qty, price} with optional section, unit.
        vat: VAT percent, None — no VAT.
        discount: discount percent, None — no discount.

    Returns:
        Record {net, discount, taxable, vat, total}; the absent discount or VAT is 0.
    """
    net = sum([line_total(item) for item in items], dec("0"))
    cut = round_money(net * discount / 100) if discount is not None else dec("0")
    taxable = net - cut
    tax = round_money(taxable * vat / 100) if vat is not None else dec("0")
    return {"net": net, "discount": cut, "taxable": taxable, "vat": tax, "total": taxable + tax}


def _amount(value):
    return num(value, digits=2)


def _exact(value, least):
    """The value with as many decimals as it has (at least ``least``, at most 6): 0.335 is not shown as 0.34."""
    digits = least
    while digits < 6 and round(value, digits) != value:
        digits += 1
    return num(value, digits=digits)


def _layout(items, vat, discount, currency, numbered, labels):
    """What the table shows: the columns, the head cells and the rows with their kind.

    Returns:
        Record {cols, head, span, rows}; a row is {kind, ...}: section {label, amount},
        item {cells}, sum {label, amount, bold}.
    """
    text = dict(LABELS)
    for key in labels:
        text[key] = labels[key]
    result = totals(items, vat, discount)
    head = [text["name"], text["unit"], text["qty"], text["price"] + ", " + currency, text["sum"] + ", " + currency]
    cols = [col("*"), col("14mm", align="center"), col("24mm", align="right"), col("24mm", align="right"), col("28mm", align="right")]
    if numbered:
        head = [text["number"]] + head
        cols = [col("10mm", align="right")] + cols
    rows = []
    number = 0
    many = len(sections(items)) > 1 or sections(items)[0] != ""
    for name in sections(items):
        if many:
            rows.append({"kind": "section", "label": name if name != "" else "—", "amount": _amount(section_total(items, name))})
        for item in items:
            if (item.get("section") or "") != name:
                continue
            number += 1
            cells = [item["name"], item.get("unit") or "", _exact(item["qty"], 0), _exact(item["price"], 2), _amount(line_total(item))]
            if numbered:
                cells = [str(number)] + cells
            rows.append({"kind": "item", "cells": cells})
    # Without a discount and VAT the net total is the total to pay: one row.
    closing = discount is not None or vat is not None
    rows.append({"kind": "sum", "label": text["net"] if closing else text["total"], "amount": _amount(result["net"]), "bold": True})
    if discount is not None:
        rows.append({"kind": "sum", "label": text["discount"] + " " + num(discount) + " %", "amount": _amount(-result["discount"]), "bold": False})
        rows.append({"kind": "sum", "label": text["taxable"], "amount": _amount(result["taxable"]), "bold": False})
    if vat is not None:
        rows.append({"kind": "sum", "label": text["vat"] + " " + num(vat) + " %", "amount": _amount(result["vat"]), "bold": False})
    if closing:
        rows.append({"kind": "sum", "label": text["total"], "amount": _amount(result["total"]), "bold": True})
    return {"cols": cols, "head": head, "span": len(head) - 1, "rows": rows}
|end

|% The estimate table: sections with subtotals, items, the net total, discount, VAT and the total to pay.
|% items: list of records {name, qty, price} with optional section, unit
|% vat: VAT percent (20 means 20 %); None — no VAT
|% discount: discount percent of the net total; None — no discount
|% currency: currency code of the headings; the parameter currency of the document, else UAH
|% numbered: write the column with the numbers of the items
|% labels: replaces the texts of estimate.LABELS
|def table(items, vat=None, discount=None, currency=None, numbered=True, labels={}):
  |let(t=_checked_layout(items, vat, discount, currency or param("currency", "UAH"), numbered, labels))
  |table(cols=t["cols"], header=1, repeat_header=True):
  |row:
  |for(c in t["head"]):
  |cell: |(c)
  |endfor
  |end row
  |for(r in t["rows"]):
  |if(r["kind"] == "section"):
  |:(background="#eeeeee")|&(span=t["span"], align="left") |*{|(r["label"])} |& |*{|(r["amount"])}
  |elif(r["kind"] == "item"):
  |row:
  |for(c in r["cells"]):
  |cell: |(c)
  |endfor
  |end row
  |elif(r["bold"]):
  |:|&(span=t["span"], align="right") |*{|(r["label"])} |& |*{|(r["amount"])}
  |else:
  |:|&(span=t["span"], align="right") |(r["label"]) |& |(r["amount"])
  |endif
  |endfor
  |end table
|enddef

|% The total to pay in figures and in words (money_full).
|% items: list of records {name, qty, price} with optional section, unit
|% vat: VAT percent; None — no VAT
|% discount: discount percent; None — no discount
|% currency: currency code; the parameter currency of the document, else UAH
|def total_words(items, vat=None, discount=None, currency=None):
  |(money_full(_checked_total(items, vat, discount), currency or param("currency", "UAH")))
|enddef

|code:
def _checked_layout(items, vat, discount, currency, numbered, labels):
    """The layout of the table; the document fails with the reason when the data are wrong."""
    reason = problem(items, vat, discount)
    if reason != "":
        fail("estimate: " + reason)
    return _layout(items, vat, discount, currency, numbered, labels)


def _checked_total(items, vat, discount):
    """The total to pay; the document fails with the reason when the data are wrong."""
    reason = problem(items, vat, discount)
    if reason != "":
        fail("estimate: " + reason)
    return totals(items, vat, discount)["total"]
|end
