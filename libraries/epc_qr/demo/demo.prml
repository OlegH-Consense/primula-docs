|% Names and the IBAN are the published EPC069-12 examples, not a person's details.
|import("lib/epc_qr")
|code:
text = epc_qr.payload("François D'Alsace S.A.", "FR1420041010050500013M02606", amount=dec("12.3"), text="Client:Marie Louise La Lune", version="002", encoding="iso-8859-1")
|end
