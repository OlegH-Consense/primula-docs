expect("sex-m", names.case("Костенко Олена", "gen", sex="m"), "Костенка Олени")
expect("sex-m-voc", names.case("Костенко Олена", "voc", sex="m"), "Костенку Олено")
expect("conflict", names.case_problem("Петренко Олена Петрович", "gen", sex="f"), "по батькові суперечить аргументу sex")
expect("ru", names.case_problem("Петренко Іван Ілліч", "gen"), "по батькові не розпізнано")
expect("ru-sex", names.sex("Петренко Іван Ілліч"), None)
expect("sex-m3", names.sex("Петренко Іван Миколайович"), "m")
expect("sex-f3", names.sex("Кобилянська Марія Василівна"), "f")
expect("sex-ma", names.sex("Петренко Микола"), "m")
expect("sex-fc", names.sex("Костенко Любов"), "f")
expect("sex-none", names.sex("Петренко"), None)

got = names.parse("  Петренко   Іван\nМиколайович ")
expect("last", got["last"], "Петренко")
expect("first", got["first"], "Іван")
expect("middle", got["middle"], "Миколайович")
got2 = names.parse("Квітка-Основ'яненко Марія")
expect("hyphen", got2["last"], "Квітка-Основʼяненко")
expect("no-middle", got2["middle"], "")

expect("ini", names.initials("Петренко Іван Миколайович"), "І. М. Петренко")
expect("ini-after", names.initials("Петренко Іван Миколайович", style="after"), "Петренко І. М.")
expect("ini-2", names.initials("Петренко Іван"), "І. Петренко")
expect("ini-2a", names.initials("Петренко Іван", style="after"), "Петренко І.")
expect("sig", names.signature("Петренко Іван Миколайович"), "Іван ПЕТРЕНКО")
expect("sig-g", names.signature("Ґалаґан Ігор Петрович"), "Ігор ҐАЛАҐАН")
expect("sig-apo", names.signature("Квітка-Основ'яненко Іван"), "Іван КВІТКА-ОСНОВʼЯНЕНКО")
expect("style", names.initials_problem("Петренко Іван", style="mid"), "невідомий стиль ініціалів")

extra = {"Мороз": {"gen": "Морозенка", "dat": "Морозенкові", "acc": "Морозенка", "ins": "Морозенком", "loc": "Морозенкові", "voc": "Морозенку"}}
expect("over", names.case("Мороз Олег Петрович", "gen", exceptions=extra), "Морозенка Олега Петровича")
bad = {"Мороз": {"gen": "Мороза"}}
expect("bad-ex", names.case_problem("Мороз Олег Петрович", "dat", exceptions=bad), "неповна парадигма винятку")

expect("one", names.case_problem("Петренко", "gen"), "потрібні прізвище й імʼя")
expect("many", names.parse_problem("Петренко Іван Миколайович молодший"), "забагато слів")
expect("empty", names.parse_problem("   "), "порожній рядок")
expect("latin", names.parse_problem("Smith John"), "латиниця не підтримується")
expect("digit", names.parse_problem("Петренко Іван 2"), "цифри в імені не підтримуються")
expect("type", names.case_problem(10, "gen"), "очікується текст")
expect("which", names.case_problem("Петренко Іван", "nom"), "невідомий відмінок")
expect("pos", names.position_case("Директор", "gen"), "директора")
expect("pos-voc", names.position_case("начальник", "voc"), "начальнику")
expect("pos-phrase", names.position_case("генеральний   директор", "ins"), "генеральним директором")
expect("pos-fin", names.position_case("Фінансовий директор", "gen"), "фінансового директора")
expect("pos-head", names.position_case("голова правління", "dat"), "голові правління")
expect("pos-miss", names.position_problem("космонавт", "gen"), "немає в словнику посад")
expect("pos-case", names.position_problem("директор", "nom"), "невідомий відмінок")
expect("ver", names.VERSION, "0.1.0")
|end
