|% Expected forms are literals. Orthography exemplars follow
|% Український правопис 2019 §§ 142–143, 85, 87, 146 as read on
|% slovnyk.ua on 2026-10-31. Where that text lists two endings,
|% the literal is the first. Regular -енко/-ко rows repeat the
|% same endings. They are not produced by the library under test.
|import("../names")
|code:
def expect(name, got, wanted):
    if got != wanted:
        fail(f"{name}: отримано {repr(got)}, очікувалося {repr(wanted)}")

def person(nom, gen, dat, acc, ins, loc, voc):
    """Six cases of one nominative. sex is inferred."""
    expect(nom + " gen", names.case(nom, "gen"), gen)
    expect(nom + " dat", names.case(nom, "dat"), dat)
    expect(nom + " acc", names.case(nom, "acc"), acc)
    expect(nom + " ins", names.case(nom, "ins"), ins)
    expect(nom + " loc", names.case(nom, "loc"), loc)
    expect(nom + " voc", names.case(nom, "voc"), voc)

