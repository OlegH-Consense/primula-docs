---
kind: module
---
|% bib — a list of references by DSTU 8302:2015 and numbered citations [3, с. 45].
|% Sources are plain records; registry() fixes the numbers once, |bib.cite(reg, "key") writes the number
|% in the text, |bib.references(reg) writes the list. The rules and the limits are in README.md.
|% A document imports the module with |import("lib/bib").
|code:
VERSION = "0.1.0"

# Words of the entries and of the citations. registry(labels={...}) replaces any of them.
LABELS = {
    "total": "с.",
    "range": "С.",
    "cite_page": "с.",
    "et_al": "[та ін.]",
    "accessed": "дата звернення",
    "volume": "Т.",
    "issue": "№",
    "from": "від",
}

TYPES = ["book", "article", "web", "act"]


def _text_problem(src, field, where):
    """Reason when the field is not a non-empty text, or ""."""
    value = src.get(field)
    if type(value) != "str" or value == "":
        return where + ": немає поля " + field
    return ""


def problem(sources):
    """Why the sources cannot be used, or "".

    Args:
        sources: list of records {key, type, title, …}; type is book, article, web or act.

    Returns:
        The first reason in Ukrainian, "" when everything is in order.
    """
    if type(sources) != "list" or len(sources) == 0:
        return "очікується непорожній список джерел"
    seen = []
    for number, src in enumerate(sources, 1):
        where = f"джерело {number}"
        if type(src) != "dict":
            return where + ": очікується запис"
        reason = _text_problem(src, "key", where)
        if reason != "":
            return reason
        if src["key"] in seen:
            return where + ": повторний ключ " + src["key"]
        seen.append(src["key"])
        where = f"джерело {src['key']}"
        if src.get("type") not in TYPES:
            return where + ": тип має бути одним із " + ", ".join(TYPES)
        reason = _text_problem(src, "title", where)
        if reason == "" and src["type"] == "book":
            reason = _text_problem(src, "publisher", where)
        if reason == "" and src["type"] in ("book", "article"):
            if type(src.get("year")) != "decimal":
                reason = where + ": немає поля year (число)"
        if reason == "" and src["type"] == "article":
            reason = _text_problem(src, "journal", where)
        if reason == "" and src["type"] == "web":
            reason = _text_problem(src, "url", where)
        if reason == "" and src["type"] == "act":
            reason = _text_problem(src, "kind", where)
        if reason != "":
            return reason
        authors = src.get("authors")
        if authors is not None and (type(authors) != "list" or len([a for a in authors if type(a) != "str"]) > 0):
            return where + ": authors — список рядків «Прізвище І. Б.»"
    return ""


def _dot(text):
    """The text with a full stop at the end unless it ends with . ? or !."""
    if text == "" or text[-1] in ".?!":
        return text
    return text + "."


def _inverted(author):
    """«Шевченко Т. Г.» → «Т. Г. Шевченко» (the name of the author for the statement of responsibility)."""
    parts = author.split(" ")
    if len(parts) < 2:
        return author
    return " ".join(parts[1:] + [parts[0]])


def _heads(src):
    """Authors under whom the entry stands: up to three, else none (the entry starts with the title)."""
    authors = src.get("authors") or []
    return authors if len(authors) <= 3 else []


def _responsibility(src, labels):
    """The statement of responsibility «І. Б. Прізвище, … [та ін.]», or ""."""
    authors = src.get("authors") or []
    if len(authors) == 0:
        return ""
    shown = [_inverted(a) for a in authors[:3]]
    text = ", ".join(shown)
    if len(authors) > 3:
        text = text + " " + labels["et_al"]
    return text


def _title_block(src, labels, responsibility):
    """Title, subtitle and, when asked, «/ відомості про відповідальність»."""
    block = src["title"]
    if src.get("subtitle"):
        block = block + " : " + src["subtitle"]
    statement = _responsibility(src, labels)
    if responsibility and statement != "":
        block = block + " / " + statement
    return block


def _head_text(src):
    heads = _heads(src)
    return ", ".join(heads) + " " if len(heads) > 0 else ""


def _web_tail(src, labels):
    text = ""
    if src.get("url"):
        text = " URL: " + src["url"]
        if src.get("accessed"):
            text = text + " (" + labels["accessed"] + ": " + src["accessed"] + ")"
        text = text + "."
    return text


def entry(src, labels=LABELS, responsibility=True):
    """The entry of one source in the form of DSTU 8302:2015 (see README.md for what is not covered).

    Args:
        src: record {key, type, title, …}.
        labels: words of the entry (LABELS).
        responsibility: write «/ І. Б. Прізвище» after the title of a book.

    Returns:
        The entry as one line of text, without a number.
    """
    kind = src["type"]
    if kind == "book":
        text = _head_text(src) + _dot(_title_block(src, labels, responsibility))
        if src.get("edition"):
            text = text + " " + _dot(src["edition"])
        imprint = (src["place"] + " : " if src.get("place") else "") + src["publisher"] + ", " + str(int(src["year"]))
        text = text + " " + _dot(imprint)
        if src.get("pages") is not None:
            text = text + " " + str(src["pages"]) + " " + labels["total"]
        return text
    if kind == "article":
        text = _head_text(src) + _dot(_title_block(src, labels, False))
        text = text + " " + _dot(src["journal"]) + " " + _dot(str(int(src["year"])))
        numbering = []
        if src.get("volume") is not None:
            numbering.append(labels["volume"] + " " + str(src["volume"]))
        if src.get("issue") is not None:
            numbering.append(labels["issue"] + " " + str(src["issue"]))
        if len(numbering) > 0:
            text = text + " " + _dot(", ".join(numbering))
        if src.get("pages") is not None:
            text = text + " " + labels["range"] + " " + str(src["pages"]) + "."
        return text
    if kind == "web":
        return _head_text(src) + _dot(_title_block(src, labels, False)) + _web_tail(src, labels)
    text = src["title"] + " : " + src["kind"]
    if src.get("date"):
        text = text + " " + labels["from"] + " " + src["date"]
    if src.get("number"):
        text = text + " № " + src["number"]
    return _dot(text) + _web_tail(src, labels)


def _heading(src):
    """The word an alphabetical list sorts by: the first author, or the title."""
    heads = _heads(src)
    return heads[0] if len(heads) > 0 else src["title"]


def _alphabet_key(src):
    """Sort key: Cyrillic before Latin and the rest, each by its alphabet (Ґ after Г, Є after Е)."""
    word = _heading(src)
    first = word[0]
    group = 0 if first >= "Ѐ" and first <= "ӿ" else 1
    return (group, sort_key(word, lang="uk"))


def _unique(values):
    """The values without repeats, in the order of the first appearance."""
    found = []
    for value in values:
        if value not in found:
            found.append(value)
    return found


def registry(sources, order=None, labels={}, responsibility=True):
    """Fix the numbers and the entries of the sources.

    Args:
        sources: list of records {key, type, title, …} (see problem()).
        order: the parameter bib_order of the document, else "alphabet". "alphabet" — Cyrillic first, then Latin, by the first author or the title;
            "given" — in the order of the list; "mention" — in the order of the first citation in
            the text, and only the cited sources are listed (the document is evaluated twice,
            collect()/collected(), decision 143; unused() names the sources that nobody cited).
        labels: replaces words of LABELS.
        responsibility: write «/ І. Б. Прізвище» after the title of a book.

    Returns:
        Record {keys, numbers, entries, labels, all, mention}: keys in the order of the list,
        numbers and entries by key, all — every key of the sources. The document fails with the
        reason when the data are wrong.
    """
    reason = problem(sources)
    if reason != "":
        fail("bib: " + reason)
    order = order or param("bib_order", "alphabet")
    if order not in ("alphabet", "given", "mention"):
        fail("bib: order має бути alphabet, given або mention")
    words = dict(LABELS)
    for name in labels:
        words[name] = labels[name]
    by_key = {}
    for src in sources:
        by_key[src["key"]] = src
    if order == "mention":
        ordered = [by_key[k] for k in _unique(collected("bib")) if k in by_key]
    elif order == "alphabet":
        ordered = sorted(sources, key=_alphabet_key)
    else:
        ordered = sources
    numbers = {}
    entries = {}
    keys = []
    for position, src in enumerate(ordered, 1):
        numbers[src["key"]] = position
        entries[src["key"]] = entry(src, words, responsibility)
        keys.append(src["key"])
    return {"keys": keys, "numbers": numbers, "entries": entries, "labels": words,
            "all": [src["key"] for src in sources], "mention": order == "mention"}


def unused(reg):
    """Keys of the sources that the text never cites (order="mention"; otherwise the sources outside the list)."""
    return [k for k in reg["all"] if k not in reg["numbers"]]


def number(reg, key):
    """The number of a source; the document fails when the key is unknown.

    With order="mention" the number is 0 in the first pass of the evaluation (the output of that pass is dropped).
    """
    if key not in reg["all"]:
        fail("bib: невідомий ключ джерела: " + key)
    if reg["mention"]:
        collect("bib", key)
    return reg["numbers"].get(key, 0)


def cite_text(reg, key, pages=None):
    """«[3]», «[3, с. 45]» or, for a list of keys, «[1; 3]» (pages go with one key only)."""
    if type(key) == "list":
        if pages is not None:
            fail("bib: сторінки можна вказати лише для одного джерела")
        return "[" + "; ".join([str(number(reg, k)) for k in key]) + "]"
    text = str(number(reg, key))
    if pages is not None:
        text = text + ", " + reg["labels"]["cite_page"] + " " + str(pages)
    return "[" + text + "]"
|end

|% Citation in the text: [3], [3, с. 45], or [1; 3] for a list of keys.
|% reg: the result of registry()
|% key: the key of a source, or a list of keys
|% pages: pages for the citation, for one key only (the text "с. " goes before them)
|def cite(reg, key, pages=None):
  |(cite_text(reg, key, pages))
|enddef

|% The numbered list of references, in the order of the numbers of registry().
|% reg: the result of registry()
|def references(reg):
  |for(k in reg["keys"]):
  |# |(reg["entries"][k])
  |endfor
|enddef
