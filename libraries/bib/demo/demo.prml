---
doc: {title: "Приклад bib", language: uk-UA}
---
|import("lib/bib")
|code:
sources = [
    {"key": "melnyk", "type": "book", "authors": ["Мельник Л. Г."], "title": "Екологічна економіка", "subtitle": "підручник",
     "place": "Суми", "publisher": "Університетська книга", "year": dec("2010"), "pages": dec("346")},
    {"key": "kizima", "type": "article", "authors": ["Кізіма Я. О."], "title": "Біокомп'ютерні технології та методики",
     "journal": "Вісник НТУУ «КПІ»", "year": dec("2013"), "issue": dec("1"), "pages": "55–57"},
    {"key": "russell", "type": "book", "authors": ["Russell S.", "Norvig P."], "title": "Artificial intelligence : a modern approach",
     "place": "Hoboken", "publisher": "Pearson", "year": dec("2021"), "edition": "4th ed.", "pages": dec("1136")},
    {"key": "pdp", "type": "act", "title": "Про захист персональних даних", "kind": "Закон України", "date": "01.06.2010", "number": "2297-VI",
     "url": "https://zakon.rada.gov.ua/laws/show/2297-17", "accessed": "01.11.2026"},
    {"key": "site", "type": "web", "title": "Primula Docs", "url": "https://example.org/primula", "accessed": "05.11.2026"},
]
reg = bib.registry(sources)
|end
|<  Вступ

Про персональні дані див. |bib.cite(reg, "pdp"); методи — |bib.cite(reg, "kizima", pages="56"); огляд — |bib.cite(reg, ["melnyk", "russell"]).

|< Список використаних джерел

|bib.references(reg)
