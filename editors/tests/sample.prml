|% Тестовий файл підсвічування Primula v1.1: охоплює всі лексичні конструкції.
|import("std/math")
|let(tax = 20, export=True)

|code:
# обчислення в ядрі (підмножина Python)
items = load_csv("data/items.csv", types={"qty": "decimal", "price": "money"})
net = sum(it.qty * it.price for it in items)  # сума без ПДВ
def with_tax(x, rate=20):
    return x * (100 + rate) / 100 if x > 0 else None
total = with_tax(net, vat_rate)
|end

