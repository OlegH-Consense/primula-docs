# --- внутристрочные формы: тело {…} до первой «}» (без вложенности) ---
context |\*{ } white base bold
context |/{ } lightgray base italic
context |_{ } lightgray base underline
context |^{ } cyan
context |,{ } cyan
context |—{ } gray
context |`{ } brightgreen
context |"{ } green
context |?{ } white red
context |.+{ } brightcyan

# --- YAML-заголовок ---
# --- YAML-заголовок: от «---» до «---» (в начале файла) ---
context linestart --- linestart --- cyan
  keyword +: brightcyan
  keyword "*" green
  keyword '*' green
  keyword #*\n brown
