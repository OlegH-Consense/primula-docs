# Подсветка Primula v1.1-draft для mcedit — сгенерировано gen_mcedit.py.
# Не править вручную: правится prml_lexicon.py / gen_mcedit.py.
# Ограничения движка mcedit: см. README (нет вложенности и регулярных выражений).

# '.' слева от слова = атрибут (it.qty), а не отдельное имя функции
wholechars left ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789.
wholechars right ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789

context default
  # экранирования (разд. 3.3)
  keyword || magenta
  keyword |{ magenta
  keyword |} magenta
  keyword |; magenta
  keyword |~ magenta
  keyword |\\ magenta
  # недопустимые и зарезервированные формы — ошибка (разд. 3.1)
  keyword |\s white red
  keyword |$ white red
  keyword |[ white red
  keyword |] white red
  keyword |– white red
  keyword |− white red
  # закрывающие маркеры (разд. 3.5)
  keyword whole linestart |endif yellow
  keyword whole linestart |endfor yellow
  keyword whole linestart |enddef yellow
  keyword linestart |end\{>!\}\[>\] yellow
  keyword linestart |end.+ yellow
  keyword linestart |end\s+ yellow
  keyword whole linestart |end yellow
  # заголовки: вся строка (внутристрочные формы внутри не различаются)
  keyword linestart |<*\n brightmagenta
  # пункты, списки, предупреждения, строки таблиц, ячейки
  keyword linestart |>\[>\] brightgreen
  keyword linestart |\{-#\}\[-#\] brightgreen
  keyword linestart |! brightgreen
  keyword linestart |: brightgreen
  keyword |& brightgreen
  # управляющие конструкции
  keyword linestart |.+: cyan
  keyword whole |else yellow
  keyword whole |def yellow
  keyword whole |if yellow
  keyword whole |elif yellow
  keyword whole |for yellow
  # модульные и встроенные команды (до общего правила пользовательских)
  keyword whole |include brightred
  keyword whole |import brightred
  keyword whole |field.chapter brightcyan
  keyword whole |field.pages brightcyan
  keyword whole |field.title brightcyan
  keyword whole |field.page brightcyan
  keyword whole |newcolumn brightcyan
  keyword whole |toc_entry brightcyan
  keyword whole |watermark brightcyan
  keyword whole |appendix brightcyan
  keyword whole |document brightcyan
  keyword whole |footnote brightcyan
  keyword whole |parallel brightcyan
  keyword whole |verbatim brightcyan
  keyword whole |caption brightcyan
  keyword whole |comment brightcyan
  keyword whole |endnote brightcyan
  keyword whole |list_of brightcyan
  keyword whole |newpage brightcyan
  keyword whole |section brightcyan
  keyword whole |segment brightcyan
  keyword whole |export brightcyan
  keyword whole |figure brightcyan
  keyword whole |footer brightcyan
  keyword whole |header brightcyan
  keyword whole |block brightcyan
  keyword whole |frame brightcyan
  keyword whole |index brightcyan
  keyword whole |scope brightcyan
  keyword whole |table brightcyan
  keyword whole |track brightcyan
  keyword whole |abbr brightcyan
  keyword whole |call brightcyan
  keyword whole |cell brightcyan
  keyword whole |code brightcyan
  keyword whole |link brightcyan
  keyword whole |list brightcyan
  keyword whole |page brightcyan
  keyword whole |part brightcyan
  keyword whole |fmt brightcyan
  keyword whole |img brightcyan
  keyword whole |let brightcyan
  keyword whole |row brightcyan
  keyword whole |set brightcyan
  keyword whole |toc brightcyan
  keyword whole |field.+ brightcyan
  # команда пользователя/модуля: |имя, |модуль.имя (только латиница)
  keyword whole |\{ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\}\[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_0123456789.\] cyan

# --- комментарий |% до конца строки ---
context |% \n brown

# --- блоки до |end ---
context exclusive whole |code: |end lightgray
  # --- подмножество Python (разд. 12) ---
  keyword #*\n brown
  keyword "*" green
  keyword '*' green
  keyword whole class white red
  keyword whole import white red
  keyword whole from white red
  keyword whole try white red
  keyword whole except white red
