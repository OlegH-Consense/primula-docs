context exclusive whole |comment: linestart |end brown
context exclusive whole |verbatim: linestart |end gray
context exclusive whole |verbatim(end="EOF"): linestart EOF gray
context exclusive whole |verbatim(end="END"): linestart END gray

# --- выражения |( … ) и формулы |=( … ) ---
context |( ) green
context |=( ) green

