# Подсветка Primula (файлы с кодом: *.s.prml, *.p.prml) для mcedit.
# Сгенерировано gen_mcedit.py.

context default
  # --- подмножество Python (разд. 12) ---
  keyword #*\n brown
  keyword "*" green
  keyword '*' green
  keyword whole class white red
  keyword whole import white red
  keyword whole from white red
  keyword whole try white red
  keyword whole except white red
