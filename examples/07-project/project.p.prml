---
# Example 7: the code section of the project.  Its definitions are names
# of the "project" level (spec 10.4): every document of the project sees
# `акти` and `параметри_акта`; the descriptive parameters are `project.*`
# and plain names.  The data file is read only when `акти` is used.
акти = load_csv("data/акти.csv", types={"номер": "decimal", "дата": "datetime", "сума": "money"})


def параметри_акта(р):
    """Parameters of акт.prml for one CSV row (only declared parameters, 10.7)."""
    return {"номер": р.номер, "дата": р.дата, "період": р.період, "сума": р.сума}


# Batch build (primula build project.p.prml): one act per CSV row.  When a
# single document of the project is built, batch_mode() is False and the
# loop does not run.
if batch_mode():
    for р in акти:
        build("акт.prml", params=параметри_акта(р), output=f"out/акт-{р.номер}.odt")
