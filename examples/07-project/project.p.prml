params:
  місто: "м. Харків"
  договір: {номер: "ТО-2026/14", дата: 2026-01-12}
  абонплата: 18500.00
  ставка_пдв: 20
  виконавець:
    назва: "ТОВ «Тепло-Сервіс Схід»"
    в_особі: "директора Коваленка Петра Івановича"
    підписант: "П. І. Коваленко"
    код: "41234567"
    адреса: "61001, м. Харків, вул. Умовна, 1"
  замовник:
    назва: "ТОВ «Агрохліб Слобожанщина»"
    в_особі: "директорки Мельник Олени Сергіївни"
    підписант: "О. С. Мельник"
    код: "42345678"
    адреса: "62301, Харківська обл., м. Дергачі, вул. Умовна, 2"
