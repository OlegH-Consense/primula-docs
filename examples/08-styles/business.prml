doc:
  title: "Набір стилів business"
  identifier: "А-2026/014"
  language: uk-UA
styles: [std/styles/business]
params:
  місто: "м. Харків"
  дата: 2026-10-16
  виконавець: {назва: "ТОВ «Виконавець»", код: "00000000", адреса: "м. Харків, вул. Сумська, 1", iban: "UA00 0000 0000 0000 0000 0000 000", підписант: "П. П. Петренко", посада: "Директор"}
  замовник: {назва: "ТОВ «Замовник»", код: "11111111", адреса: "м. Київ, вул. Хрещатик, 2", iban: "UA11 1111 1111 1111 1111 1111 111", підписант: "І. І. Іваненко", посада: "Директор"}
---
|% Gallery of std/styles/business (stage 15.3): an act of acceptance with the
|% styles of the set — title block, place and date, preamble, clauses, the
|% service table, the schedule, requisites of the parties and signatures.
|% The requisites are placeholders.
|code:
послуги = [
    record(назва="Налаштування обладнання", кількість=dec("2"), ціна=dec("1500.00")),
    record(назва="Навчання персоналу", кількість=dec("1"), ціна=dec("2400.00")),
]
сума = sum([п.кількість * п.ціна for п in послуги])
|end
|.OrganizationName: |(виконавець.назва)

|.Approval: ЗАТВЕРДЖУЮ
|.Approval: |(замовник.посада) |(замовник.назва)
|.Approval: ______________ |(замовник.підписант)
|.Approval: |(fmt_date(дата, "contract"))

|.DocumentTitle: АКТ № |(doc.identifier)
|.DocumentSubtitle: приймання-передачі наданих послуг
|.DocumentVersion: до Договору № П-2026/017 від 12.10.2026
|.DatePlace: |(місто), |(fmt_date(дата, "contract"))

|.Preamble: |(виконавець.назва) (далі — |.DefinedTerm{Виконавець}) в особі директора |(виконавець.підписант) та |(замовник.назва) (далі — |.DefinedTerm{Замовник}) в особі директора |(замовник.підписант) склали цей акт про таке.

|<(id="обсяг") Обсяг наданих послуг
|> Виконавець надав, а Замовник прийняв такі послуги:

|table(style="TableServices", header=1, footer=1, cols=["52%", col("12%", id="к", type="decimal", align="right"), col("18%", id="ц", type="money", align="right"), col("18%", id="с", type="money", currency="UAH", align="right")]):
|: Послуга |& Кількість |& Ціна, грн |& Сума, грн
|for(п in послуги):
|: |(п.назва) |& |(п.кількість) |& |(п.ціна) |& |=(this_row("к") * this_row("ц"))
|endfor
|:|&(span=3, align="right") Разом |& |=(sum(column("с", rows=body_rows())))
|end table

|> Загальна вартість послуг становить |(money_full(сума, "UAH")).
|.ClauseContinuation: Сторони претензій щодо обсягу, якості та строків надання послуг не мають.

|<(id="графік") Графік подальших робіт
|table(style="TableSchedule", header=1):
|: Етап |& Результат |& Строк
|: Технічна підтримка |& Звіт про звернення |& 30.11.2026
|: Повторне навчання |& Протокол навчання |& 15.12.2026
|end table

|.Note: Примітка. Строк повторного навчання погоджується листом Замовника.

|.AttachmentLabel: Додатки: протокол навчання на 2 арк.

|<(number=False) Реквізити і підписи сторін
|table(style="TableParties", header=1):
|: Виконавець |& Замовник
|: |(виконавець.назва) |& |(замовник.назва)
|: Код ЄДРПОУ |(виконавець.код) |& Код ЄДРПОУ |(замовник.код)
|: |(виконавець.адреса) |& |(замовник.адреса)
|: IBAN |(виконавець.iban) |& IBAN |(замовник.iban)
|: |(виконавець.посада) |& |(замовник.посада)
|: ______________ |(виконавець.підписант) |& ______________ |(замовник.підписант)
|end table
